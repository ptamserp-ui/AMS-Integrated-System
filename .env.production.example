# Template untuk rilis penuh. Salin ke .env.production di server; jangan commit file .env.production.
NODE_ENV="production"
PORT="3000"
# Contoh saja; ganti dengan origin production yang telah diverifikasi.
APP_URL="https://production.example.com"
DEPLOYMENT_ENV="production"
VITE_DEPLOYMENT_ENV="production"
AMS_DB_DRIVER="firebase"
AMS_DATA_DIR="/var/lib/ams-data"

# Customer Portal: jangan aktifkan sebelum prasyarat docs/customer-portal.md dan staging lulus.
CUSTOMER_PORTAL_ENABLED="false"
CUSTOMER_PRIVACY_URL=""
CUSTOMER_TERMS_URL=""
CUSTOMER_PRIVACY_VERSION=""

# Proyek production wajib ams-integrated-system. Ambil detail Web App dari Firebase Console.
VITE_FIREBASE_API_KEY="GANTI_API_KEY_FIREBASE_PRODUCTION"
VITE_FIREBASE_AUTH_DOMAIN="GANTI_AUTH_DOMAIN_FIREBASE_PRODUCTION"
VITE_FIREBASE_PROJECT_ID="ams-integrated-system"
VITE_FIREBASE_EXPECTED_PROJECT_ID="ams-integrated-system"
VITE_FIREBASE_STORAGE_BUCKET="GANTI_STORAGE_BUCKET_FIREBASE_PRODUCTION"
VITE_FIREBASE_MESSAGING_SENDER_ID="GANTI_MESSAGING_SENDER_ID_PRODUCTION"
VITE_FIREBASE_APP_ID="GANTI_APP_ID_FIREBASE_PRODUCTION"
VITE_FIRESTORE_DATABASE_ID="GANTI_DATABASE_ID_PRODUCTION"
VITE_FIREBASE_ADMIN_EMAIL="ptams.erp@gmail.com"

# Isi dengan Database ID yang telah diverifikasi di proyek ams-integrated-system.
# Set ke "(default)" hanya jika database itu benar-benar telah dibuat dan dipakai.
FIREBASE_PROJECT_ID="ams-integrated-system"
FIREBASE_EXPECTED_PROJECT_ID="ams-integrated-system"
FIRESTORE_DATABASE_ID="GANTI_DATABASE_ID_PRODUCTION"
FIREBASE_FIRESTORE_DATABASE_ID="GANTI_DATABASE_ID_PRODUCTION"
FIRESTORE_EXPECTED_DATABASE_ID="GANTI_DATABASE_ID_PRODUCTION"
FIREBASE_SERVICE_ACCOUNT_PATH="/etc/ams/secrets/ams-integrated-system-service-account.json"

# Rahasia wajib dibuat/disimpan langsung di server; jangan taruh di Git atau chat.
SESSION_SECRET="GANTI_DENGAN_64_KARAKTER_HEX_ACAK"
INITIAL_SETUP_TOKEN="GANTI_TOKEN_SETUP_AWAL_PRODUCTION"
AMS_ADMIN_TOKEN=""
BOOTSTRAP_DEV_USERNAME="dev.admin"
BOOTSTRAP_DEV_FULLNAME="Administrator AMS"
BOOTSTRAP_DEV_EMAIL="ptams.erp@gmail.com"
BOOTSTRAP_DEV_ROLE_ID="Developer & IT Support"
BOOTSTRAP_DEV_PASSWORD_HASH=""
BOOTSTRAP_DEV_PASSWORD=""
FIREBASE_ADMIN_EMAILS="ptams.erp@gmail.com,antraderyll@gmail.com"
