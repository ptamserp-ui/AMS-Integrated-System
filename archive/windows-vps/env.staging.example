# ==============================================================================
# Template Environment Firebase Staging — Windows Server VPS (AMS Integrated)
# Salin file ini menjadi ".env.staging" di folder aplikasi VPS (mis. C:\AMS\App\.env.staging)
# PENTING: Jangan pernah commit file ".env.staging" berisi secret ke repositori Git.
# ==============================================================================

# 1. Runtime Node & Identitas Staging
NODE_ENV="production"
PORT="3000"
APP_URL="https://ams.bejodigitalprint.com"
DEPLOYMENT_ENV="staging"
VITE_DEPLOYMENT_ENV="staging"

# 2. Driver Database & Penyimpanan Persisten Windows
# Pada Windows Server VPS, simpan data persisten di luar folder source code/build:
AMS_DB_DRIVER="firebase"
AMS_DATA_DIR="C:\\AMS\\Data"

# Customer Portal: tetap nonaktif sampai prasyarat docs/customer-portal.md diverifikasi.
CUSTOMER_PORTAL_ENABLED="false"
CUSTOMER_PRIVACY_URL=""
CUSTOMER_TERMS_URL=""
CUSTOMER_PRIVACY_VERSION=""

# 3. Konfigurasi Firebase Project STAGING (WAJIB terpisah dari firebase-applet-config.json)
# Proyek staging: ams-integrated-staging. Isi nilai Web App dari Firebase Console.
VITE_FIREBASE_API_KEY="GANTI_API_KEY_FIREBASE_STAGING"
VITE_FIREBASE_AUTH_DOMAIN="GANTI_AUTH_DOMAIN_FIREBASE_STAGING"
VITE_FIREBASE_PROJECT_ID="ams-integrated-staging"
VITE_FIREBASE_EXPECTED_PROJECT_ID="ams-integrated-staging"
VITE_FIREBASE_STORAGE_BUCKET="GANTI_STORAGE_BUCKET_FIREBASE_STAGING"
VITE_FIREBASE_MESSAGING_SENDER_ID="GANTI_MESSAGING_SENDER_ID_STAGING"
VITE_FIREBASE_APP_ID="GANTI_APP_ID_FIREBASE_STAGING"
VITE_FIRESTORE_DATABASE_ID="(default)"
VITE_FIREBASE_ADMIN_EMAIL="ptams.erp@gmail.com,cloud.ams2026@gmail.com"

# 3b. Firebase Admin SDK (Koneksi Server Express -> Firestore Aman di Windows VPS)
# Unduh Private Key JSON dari Firebase Console -> Project Settings -> Service accounts
# lalu simpan di luar folder Git/build, misalnya C:\AMS\Secrets\firebase-service-account.json
FIREBASE_PROJECT_ID="ams-integrated-staging"
FIREBASE_EXPECTED_PROJECT_ID="ams-integrated-staging"
FIRESTORE_DATABASE_ID="(default)"
FIREBASE_FIRESTORE_DATABASE_ID="(default)"
FIRESTORE_EXPECTED_DATABASE_ID="(default)"
FIREBASE_SERVICE_ACCOUNT_PATH="C:\\AMS\\Secrets\\ams-integrated-staging-service-account.json"
# Alternatif jika tidak memakai file di disk (isi JSON string atau Base64):
# FIREBASE_SERVICE_ACCOUNT_JSON=""

# 3c. Terjemahan situs publik ID/EN (opsional; kunci hanya digunakan oleh server)
# Ambil API key dari akun DeepL dan isi pada .env.staging di VPS, jangan commit nilainya.
DEEPL_AUTH_KEY=""
DEEPL_API_URL="https://api-free.deepl.com"

# 4. Keamanan Sesi & Setup Awal Server
# Buat di PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
SESSION_SECRET="GANTI_DENGAN_64_KARAKTER_HEX_ACAK"
INITIAL_SETUP_TOKEN="GANTI_TOKEN_SETUP_AWAL_STAGING"
AMS_ADMIN_TOKEN=""

# 5. Profil akun developer awal (opsional; bukan tempat menyimpan password)
BOOTSTRAP_DEV_USERNAME="dev.admin"
BOOTSTRAP_DEV_FULLNAME="Administrator AMS"
BOOTSTRAP_DEV_EMAIL="ptams.erp@gmail.com"
BOOTSTRAP_DEV_ROLE_ID="Developer & IT Support"
# Untuk bootstrap awal otomatis saja jika database RBAC belum memiliki akun.
# Pada VPS, utamakan `npm run auth:bootstrap` agar password dimasukkan secara tersembunyi
# dan hash scrypt disimpan di AMS_DATA_DIR\rbac-db.json. Jangan isi/commit password plaintext.
BOOTSTRAP_DEV_PASSWORD_HASH=""
BOOTSTRAP_DEV_PASSWORD=""
FIREBASE_ADMIN_EMAILS="ptams.erp@gmail.com,cloud.ams2026@gmail.com,antraderyll@gmail.com"
